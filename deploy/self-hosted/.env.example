# Copy to /srv/docker/casebroker/.env on the server (next to compose.yaml).
# Never commit the filled-in copy.

# The password the EXISTING data directory was initialised with (the old
# standalone `postgres` project's POSTGRES_PASSWORD).
POSTGRES_PASSWORD=
# Only if POSTGRES_PASSWORD contains @ : / ? # [ ] % -- the same password,
# percent-encoded, for the connection URL. Leave unset otherwise.
#POSTGRES_PASSWORD_URLENCODED=

# Same value(s) as CASEBROKER_WRITE_TOKENS on the Render service, so the
# running workers keep authenticating after cut-over.
CASEBROKER_WRITE_TOKENS=
#CASEBROKER_READ_TOKENS=
#CASEBROKER_SETUP_TOKEN=

# Push notifications (docs/dashboard.md, "Push notifications"). Nothing needs setting:
# the broker makes its VAPID key on first use and keeps it in Postgres, and takes the
# dashboard's https address as its contact. 0 switches push off entirely.
#CASEBROKER_PUSH=0
# Only to carry a key from another database; a new key orphans every subscribed browser.
#CASEBROKER_VAPID_PRIVATE_KEY=
# mailto: or https:, never localhost (Apple refuses it).
#CASEBROKER_VAPID_SUBJECT=mailto:ops@example.org
#CASEBROKER_PUSH_SILENT_MINUTES=20
#CASEBROKER_PUSH_STALL_HOURS=6
