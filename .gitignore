.venv/
__pycache__/

# .env.example says "Copy to .env", and that copy holds a live write token --
# which grants lease/complete/fail and adding cases. This repo is public, so an
# un-ignored .env is one `git add -A` away from publishing the campaign's
# credentials. .env.example itself stays tracked; it contains only placeholders.
.env
.env.*
!.env.example
machine.env
.DS_Store
# admin.env holds a HUMAN ADMIN's broker password -- it can change what every
# node in the fleet runs. Same reasoning as .env above, one step worse.
# admin.env.example stays tracked; it contains only placeholders.
admin.env
