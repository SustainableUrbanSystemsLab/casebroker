# Per-machine worker profile. Copy to machine.env next to this file (gitignored)
# and fill in. start_worker.sh / start_worker.ps1 read it; every variable is
# also honoured straight from the environment, so a SLURM script can export the
# same names instead.

# --- broker -------------------------------------------------------------------
CASEBROKER_URL=https://casebroker.example.org
# This machine's OWN credential, from the dashboard: sign in, Machines >
# Issue token, naming it after this box's worker id. Shown once -- only its
# hash is stored. A shared CASEBROKER_WRITE_TOKENS value from the broker also
# works, but cannot be revoked for one machine alone.
CASEBROKER_TOKEN=
# Stable per MACHINE, not per run: it is what lets a restarted worker get its
# own half-finished case back (see docs/fleet.md, "resume"). Never share one
# id between two machines.
CASEBROKER_WORKER_ID=lab-ws-01
# Shown on the dashboard as where the case ran.
CASEBROKER_CLUSTER=lab

# --- what this machine is -----------------------------------------------------
# MPI ranks per case. MEASURED per machine with the scaling sweep, not guessed:
# the knee of iterations/hour vs ranks differs between a 48-core workstation, a
# 24-core PACE allocation and a blueCFD box. Until measured: min(24, cores/2).
WIND_NP=24
# auto | podman | docker | native   (auto = first found, in that order)
WIND_RUNTIME=auto
WIND_IMAGE=docker.io/dicehub/openfoam:12
# Only for WIND_RUNTIME=native (blueCFD-Core 2024, Windows). MSYS-style paths.
BLUECFD_HOME=/c/blueCFD-Core-2024
MSMPI_BIN=/c/Program Files/Microsoft MPI/Bin

# --- where things live on this machine ---------------------------------------
# Root for the geometry cache, failed-run logs, checkpoints and archives. A
# local drive is right here -- OpenFOAM's file pattern is hostile to network
# storage, and finished cases leave via WIND_DONE anyway.
WIND_ROOT=/c/wind
# Finished cases, one <case_id>.tar.gz each. This is the folder Syncthing shares
# with the master (Send Only here, Receive Only there). Default: $WIND_ROOT/done
WIND_DONE=/c/wind/done
# Checkpoints of cases stopped mid-solve on THIS machine. Default: $WIND_ROOT/cases
WIND_CASES=/c/wind/cases
# Solver write cadence = resume granularity. Default 200 (~1-2 h of solving).
WIND_WRITE_INTERVAL=200

# --- tooling ------------------------------------------------------------------
# The e3d CLI: Windows build, or the linux-x64 single-file build on the clusters.
EDDY3D_CLI=/c/wind/bin/e3d.exe
# The real_cities checkout (geometry builder). Default: ../../real_cities
REAL_CITIES=/c/Users/me/GitHub/windcomfort-real-cities/benchmark/real_cities

# Syncthing hand-off of finished archives (optional; see docs/fleet.md, "Syncthing").
# The shared folder runs quiet -- watcher off, no periodic rescan -- and the runner
# asks Syncthing to scan the one new archive when a case completes.
# WIND_SYNCTHING_URL=http://127.0.0.1:8384
# WIND_SYNCTHING_APIKEY=   # Actions > Settings > General > API Key
# WIND_SYNCTHING_FOLDER=   # the folder ID of $WIND_DONE

# -- Bounds on one case -------------------------------------------------------
# Seconds before a case is killed and reported as a RETRYABLE failure, so
# another machine can pick it up. 0 disables the timeout.
#
# This matters more than it looks. The heartbeat thread is independent of the
# runner, so a hung solve keeps renewing its own lease: the broker never
# reclaims the case, this worker never moves on, and the allocation burns to
# walltime with nothing to show. The default is well beyond any real case
# (66 core-hours is roughly 3 wall-hours on 24 cores).
#CASEBROKER_CASE_TIMEOUT=86400

# How many lines of the runner's stdout/stderr to hold in memory. An OpenFOAM
# solve is verbose and the worker needs exactly two things from that output: the
# last stdout line (the JSON result) and a tail of stderr for the error message.
#CASEBROKER_CAPTURE_LINES=2000
